fn main(input: [count], output: []):
    results = []
    limit = 0
    for tier, tier_limit in [["free", 10], ["paid", 30]]:
        if tier == "paid":
            limit = tier_limit
    if True:
        for stage in ["fetch", "score"]:
            label = "batch-" + stage
            result = @workflow_module_constants.process(label=label, size=limit + count)
            results = results + [result]
            None
    total = @workflow_module_constants.process(label="batch-" + "total", size=30 + count)
    results = results + [total]
    None
    return results
