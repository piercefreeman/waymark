fn main(input: [key, base, factor], output: []):
    data = @workflow_helper_methods.fetch_data(key=key)
    multiplier = compute_multiplier(base=base, factor=factor)
    processed = @workflow_helper_methods.process_data(data=data, multiplier=multiplier)
    result = format_result(value=processed)
    return result

fn compute_multiplier(input: [base, factor], output: []):
    "Pure Python helper - computes a value synchronously."
    return base * factor

fn format_result(input: [value], output: []):
    "Pure Python helper - formats the final result."
    return "[RESULT: " + value + "]"
