fn main(input: [should_fail], output: []):
    recovered = False
    message = "start"
    try:
        value = @try_stateful_outputs.risky_action(should_fail=should_fail)
        message = @try_stateful_outputs.annotate_success(value=value, previous=message)
    except ValueError:
        message = @try_stateful_outputs.annotate_recovery(reason="fail", previous=message)
        recovered = True
    _return_tmp = @try_stateful_outputs.finalize_result(attempted=True, recovered=recovered, message=message)
    return _return_tmp
