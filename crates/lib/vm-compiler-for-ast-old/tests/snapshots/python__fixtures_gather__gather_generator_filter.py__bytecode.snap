fn main(input: [users], output: []):
    __spread_items_1__ = []
    for user in users:
        if user.active:
            __spread_items_1__ = __spread_items_1__ + [user]
    results = spread __spread_items_1__:user -> @gather_generator_filter.process_user(user=user)
    return results
