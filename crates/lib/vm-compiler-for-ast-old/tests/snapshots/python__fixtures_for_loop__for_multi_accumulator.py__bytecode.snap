fn main(input: [items], output: []):
    valid_items = []
    invalid_items = []
    for item in items:
        is_valid, processed = @for_multi_accumulator.multi_accum_classify_item(item=item)
        if is_valid:
            valid_items = valid_items + [processed]
        else:
            invalid_items = invalid_items + [processed]
    return {"valid": valid_items, "invalid": invalid_items}
